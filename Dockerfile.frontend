FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY package*.json ./
COPY frontend/package.json frontend/package.json
COPY gateway/package.json gateway/package.json
COPY services/auth-service/package.json services/auth-service/package.json
COPY services/link-service/package.json services/link-service/package.json
COPY services/analytics-service/package.json services/analytics-service/package.json
COPY packages/routing/package.json packages/routing/package.json
RUN npm ci --no-audit --no-fund
COPY frontend frontend
COPY packages/routing packages/routing
COPY scripts/configure-nginx.mjs scripts/configure-nginx.mjs
RUN npm run build -w frontend && node scripts/configure-nginx.mjs
FROM nginx:1.28-alpine
COPY infra/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/infra/nginx-short-links.conf /etc/nginx/short-links.conf
COPY --from=build /app/frontend/dist /usr/share/nginx/html
EXPOSE 80
