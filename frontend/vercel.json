{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci --include=dev",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://project-short-url-vt93.vercel.app/api/:path*"
    },
    {
      "source": "/s/:path*",
      "destination": "https://project-short-url-vt93.vercel.app/s/:path*"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}
