{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci --include=dev",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://project-short-url-vt93.vercel.app/api/:path*"
    },
    {
      "source": "/s/:path*",
      "destination": "https://project-short-url-vt93.vercel.app/s/:path*"
    },
    {
      "source": "/:code((?!(?:[lL][oO][gG][iI][nN]|[rR][eE][gG][iI][sS][tT][eE][rR]|[dD][aA][sS][hH][bB][oO][aA][rR][dD]|[hH][iI][sS][tT][oO][rR][yY]|[pP][rR][oO][fF][iI][lL][eE]|[aA][nN][aA][lL][yY][tT][iI][cC][sS]|[lL][iI][nN][kK][sS]|[aA][pP][iI]|[aA][sS][sS][eE][tT][sS]|[sS][tT][aA][tT][iI][cC]|[sS]|[iI][nN][tT][eE][rR][nN][aA][lL]|[hH][eE][aA][lL][tT][hH][zZ]|[rR][eE][aA][dD][yY][zZ]|[fF][aA][vV][iI][cC][oO][nN]|[rR][oO][bB][oO][tT][sS]|[sS][iI][tT][eE][mM][aA][pP]|[iI][nN][dD][eE][xX]|_[vV][eE][rR][cC][eE][lL]|_[nN][eE][xX][tT])(?:/|$))[A-Za-z0-9_-]{3,32}){/}?",
      "destination": "https://project-short-url-vt93.vercel.app/:code"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}
