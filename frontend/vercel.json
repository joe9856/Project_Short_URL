{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://configure-gateway.example/api/:path*"
    },
    {
      "source": "/s/:path*",
      "destination": "https://configure-gateway.example/s/:path*"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}
