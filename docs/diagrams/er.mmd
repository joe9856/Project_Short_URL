erDiagram
  direction TB
  %% FK in the key column denotes a reference in this combined model.
  %% Comments and line styles distinguish physical and logical references.
  %% Dashed lines here distinguish service-level references, not database FKs.
  USERS ||--o{ SESSIONS : "1 : N"
  USERS ||..o{ LINKS : "1 : N"
  LINKS ||..o{ CLICK_EVENTS : "1 : N"
  USERS ||..o{ CLICK_EVENTS : "1 : N"
  USERS {
    varchar id PK
    varchar email UK
    varchar name
    varchar passwordHash
    timestamptz createdAt
  }
  SESSIONS {
    varchar tokenHash PK
    varchar userId FK "อ้างถึง USERS.id ฐานข้อมูลบังคับ"
    timestamptz expiresAt
  }
  AUTH_RATE_LIMITS {
    varchar id PK
    int count
    timestamptz expiresAt
  }
  LINKS {
    varchar id PK
    varchar userId FK "อ้างถึง USERS.id ข้ามบริการ ฐานข้อมูลไม่บังคับ"
    varchar code UK
    text originalUrl
    boolean isActive
    timestamptz expiresAt "เว้นว่างได้"
    timestamptz createdAt
    timestamptz updatedAt
  }
  LINK_RATE_LIMITS {
    varchar id PK
    int count
    timestamptz expiresAt
  }
  CLICK_EVENTS {
    varchar id PK
    varchar eventId UK
    varchar linkId FK "อ้างถึง LINKS.id ข้ามบริการ ฐานข้อมูลไม่บังคับ"
    varchar ownerId FK "อ้างถึง USERS.id ข้ามบริการ ฐานข้อมูลไม่บังคับ"
    timestamptz clickedAt
    varchar referrerHost
    varchar deviceType
  }
