%% Short URL Microservices — deployment topology (target Vercel + Supabase)
flowchart TB
  USER["User / Web Browser"]
  VISITOR["Visitor / QR Scanner"]

  subgraph FRONT["Frontend Vercel project"]
    direction LR
    UI["React + Vite SPA<br/>Login / Create / History / QR / Stats"]
    EDGE["Frontend-domain rewrites<br/>/api/*, /:code, /s/:code"]
    UI -->|"HTTP /api requests"| EDGE
  end

  subgraph COMPUTE["Vercel backend projects — Express + TypeScript"]
    direction TB
    GW["API Gateway<br/>routing, Origin checks, session verification"]
    A["Auth Service<br/>users, sessions, profile"]
    L["Link Service<br/>short codes, redirect, QR, history"]
    T["Analytics Service<br/>click events, counts, statistics"]
    GW -->|"HTTPS + internal secret"| A
    GW -->|"HTTPS + internal secret"| L
    GW -->|"HTTPS + internal secret"| T
    L -->|"verify session"| A
    T -->|"verify session"| A
    L -->|"record visit / batch counts"| T
    T -->|"link ownership / summary"| L
  end

  subgraph PG["Supabase PostgreSQL — ONE instance, separate schemas and roles"]
    direction LR
    AD[("app_auth<br/>users / sessions / rate_limits")]
    LD[("app_links<br/>links / rate_limits")]
    TD[("app_analytics<br/>click_events")]
  end

  USER -->|"visit website"| UI
  VISITOR -->|"open short URL: /:code or /s/:code"| EDGE
  EDGE -->|"rewrites to Gateway"| GW
  A -->|"Prisma / auth_owner"| AD
  L -->|"Prisma / links_owner"| LD
  T -->|"Prisma / analytics_owner"| TD

  classDef client fill:#ffffff,stroke:#64748b,color:#0f172a,stroke-width:2px;
  classDef entry fill:#eaf3ff,stroke:#2875bc,color:#102f52,stroke-width:2px;
  classDef gateway fill:#e0f2fe,stroke:#0284c7,color:#082f49,stroke-width:2px;
  classDef service fill:#eefaf5,stroke:#2f8b74,color:#124536,stroke-width:2px;
  classDef data fill:#fff7e9,stroke:#b57525,color:#56390c,stroke-width:2px;
  class USER,VISITOR client;
  class UI,EDGE entry;
  class GW gateway;
  class A,L,T service;
  class AD,LD,TD data;
